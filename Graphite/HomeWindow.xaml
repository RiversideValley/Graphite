<Window
    x:Class="Graphite.HomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:graphite="using:Graphite.Controls"
    xmlns:graphitehelper="using:Graphite.Helpers"
    Title="Graphite Home Page">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Flyout
                x:Name="MoreFlyout"
                x:FieldModifier="Public"
                Placement="Bottom">
                <Flyout.SystemBackdrop>
                    <MicaBackdrop />
                </Flyout.SystemBackdrop>
                <StackPanel Width="250" Margin="-12,-12">
                    <StackPanel Name="menuheader">
                        <Button
                            x:Name="MainUser"
                            Margin="0,4,0,10"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            IsEnabled="True">
                            <StackPanel Orientation="Horizontal">
                                <PersonPicture
                                    x:Name="MainUserPicture"
                                    Width="32"
                                    Height="32"
                                    x:FieldModifier="Public"
                                     />
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="UserName"
                                        FontSize="15"
                                        Style="{ThemeResource SubtitleTextBlockStyle}"
                                        Text="{Binding Username}" />
                                    <TextBlock FontSize="12" Text="Local Account" />
                                </StackPanel>
                            </StackPanel>
                        </Button>
                        <Border
                            x:Name="UserBorder"
                            Margin="10,5,10,10"
                            BorderBrush="{ThemeResource ApplicationForegroundThemeBrush}"
                            BorderThickness="1"
                            Opacity="0.3"
                            Visibility="Collapsed" />
                        <StackPanel>
                            <Frame x:Name="UserFrame" Visibility="Collapsed">
                                <ListView x:Name="UserListView" x:FieldModifier="Public">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <!--  For the profile picture  -->
                                                    <ColumnDefinition Width="*" />
                                                    <!--  For the username  -->
                                                    <ColumnDefinition Width="Auto" />
                                                    <!--  For the "Switch" button  -->
                                                </Grid.ColumnDefinitions>

                                                <PersonPicture
                                                    Width="24"
                                                    Height="24"
                                                    Margin="6"
                                                    ProfilePicture="{Binding PicturePath, Mode=TwoWay}" />
                                                <!--  Username  -->
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Margin="5,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding}" />
                                                <!--  "Switch" button  -->
                                                <Button
                                                    x:Name="SwitchName"
                                                    Grid.Column="2"
                                                    Margin="10"
                                                    Content="{graphitehelper:FluentIcon Glyph=&#xE748;}"
                                                    IsEnabled="True"
                                                    Style="{ThemeResource QuietButtonStyle}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Frame>
                        </StackPanel>
                        <Border
                            Height="1"
                            Margin="-8,4"
                            Background="{ThemeResource MenuFlyoutSeparatorThemeBrush}"
                            Opacity="0.5" />
                        <Button
                            x:Name="NewTab"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            IsEnabled="True"
                            Tag="NewTab">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    FontFamily="{StaticResource FluentIcons}"
                                    FontSize="16"
                                    Glyph="&#xEC6C;" />
                                <TextBlock Margin="10,0,0,0" Text="New-Tab" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="SplitTabs"
                            Margin="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            IsEnabled="False"
                            Tag="SplitTab"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    FontFamily="{StaticResource FluentIcons}"
                                    FontSize="16"
                                    Glyph="&#xF57C;" />
                                <TextBlock Margin="10,0,0,0" Text="New-Split-Tab" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="NewWindow"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Tag="NewWindow">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    FontFamily="{StaticResource FluentIcons}"
                                    FontSize="16"
                                    Glyph="&#xE737;" />
                                <TextBlock Margin="10,0,0,0" Text="New-Window" />
                            </StackPanel>
                        </Button>
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            IsEnabled="True"
                            Tag="InPrivate">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    FontFamily="{StaticResource FluentIcons}"
                                    FontSize="16"
                                    Glyph="&#xE727;" />
                                <TextBlock Margin="10,0,0,0" Text="New-Private" />
                            </StackPanel>
                        </Button>
                        <Border
                            Height="1"
                            Margin="-8,4"
                            Background="{ThemeResource MenuFlyoutSeparatorThemeBrush}"
                            Opacity="0.5" />
                        <Button
                            x:Name="His"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            x:FieldModifier="Public"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Tag="History">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    FontFamily="{StaticResource FluentIcons}"
                                    FontSize="16"
                                    Glyph="&#xE81C;" />
                                <TextBlock Margin="10,0,0,0" Text="History" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="CollectionNames"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            x:FieldModifier="Public"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Tag="Collections">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    FontFamily="{StaticResource FluentIcons}"
                                    FontSize="16"
                                    Glyph="&#xe71d;" />
                                <TextBlock Margin="10,0,0,0" Text="Collections" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="Fav"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            x:FieldModifier="Public"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Tag="Favorites">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    FontFamily="{StaticResource FluentIcons}"
                                    FontSize="16"
                                    Glyph="&#xE728;" />
                                <TextBlock Margin="10,0,0,0" Text="Favorites" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="Down"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            x:FieldModifier="Public"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Tag="Downloads">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    FontFamily="{StaticResource FluentIcons}"
                                    FontSize="16"
                                    Glyph="&#xE896;" />
                                <TextBlock Margin="10,0,0,0" Text="Downloads" />
                            </StackPanel>
                        </Button>
                        <Border
                            Height="1"
                            Margin="-8,4"
                            Background="{ThemeResource MenuFlyoutSeparatorThemeBrush}"
                            Opacity="0.5" />
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    FontFamily="{StaticResource FluentIcons}"
                                    FontSize="16"
                                    Glyph="&#xE749;" />
                                <TextBlock Margin="10,0,0,0" Text="Print" />
                            </StackPanel>
                        </Button>
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            x:FieldModifier="Public"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Tag="FullScreen">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    x:Name="Icon"
                                    FontFamily="{StaticResource FluentIcons}"
                                    FontSize="16"
                                    Glyph="&#xE740;" />
                                <TextBlock
                                    x:Name="TextFull"
                                    Margin="10,0,0,0"
                                    Text="Full Screen" />
                            </StackPanel>
                        </Button>
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Tag="Share">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="16"
                                    Glyph="&#xE72D;" />
                                <TextBlock Margin="10,0,0,0" Text="Share" />
                            </StackPanel>
                        </Button>
                        <Border
                            Height="1"
                            Margin="-8,4"
                            Background="{ThemeResource MenuFlyoutSeparatorThemeBrush}"
                            Opacity="0.5" />
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Tag="Updated">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE777;" />
                                <TextBlock Margin="10,0,0,0" Text="Update" />
                            </StackPanel>
                        </Button>
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Tag="Ratings">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    FontFamily="{StaticResource FluentIcons}"
                                    FontSize="16"
                                    Glyph="&#xE8e1;" />
                                <TextBlock Margin="10,0,0,0" Text="Rate Us" />
                            </StackPanel>
                        </Button>
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Tag="DevTools">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    FontFamily="{StaticResource FluentIcons}"
                                    FontSize="16"
                                    Glyph="&#xEC7A;" />
                                <TextBlock Margin="10,0,0,0" Text="Dev Tools" />
                            </StackPanel>
                        </Button>
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Tag="Settings">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon
                                    FontFamily="{StaticResource FluentIcons}"
                                    FontSize="16"
                                    Glyph="&#xE713;" />
                                <TextBlock Margin="10,0,0,0" Text="Settings" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Flyout>
            <Flyout x:Name="QRCodeFlyout">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </Flyout.FlyoutPresenterStyle>

                <Grid Width="280" Padding="16" MaxHeight="500">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Style="{ThemeResource SubtitleTextBlockStyle}" Text="QR Code Generator" Margin="0,0,0,16"/>

                    <ComboBox Grid.Row="1" x:Name="QRCodeTypeComboBox" PlaceholderText="Select QR Code Type" HorizontalAlignment="Stretch" Margin="0,0,0,16" SelectedIndex="0" SelectionChanged="QRCodeTypeComboBox_SelectionChanged">
                        <ComboBoxItem Content="URL"/>
                        <ComboBoxItem Content="Text"/>
                        <ComboBoxItem Content="Phone"/>
                        <ComboBoxItem Content="Wifi"/>
                    </ComboBox>

                    <StackPanel Grid.Row="2" x:Name="WifiInputs" Visibility="Collapsed" Spacing="8" Margin="0,0,0,16">
                        <TextBox x:Name="WifiNameInput" PlaceholderText="WiFi Name"/>
                        <PasswordBox x:Name="WifiPasswordInput" PlaceholderText="WiFi Password"/>
                    </StackPanel>

                    <TextBox Grid.Row="3" x:Name="TextInput" PlaceholderText="Enter text" Visibility="Collapsed" Margin="0,0,0,16"/>

                    <TextBox Grid.Row="4" x:Name="PhoneInput" PlaceholderText="Enter phone number" Visibility="Collapsed" Margin="0,0,0,16"/>

                    <Image Grid.Row="6" x:Name="QRCodeImage" Width="200" Height="200" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <Button Grid.Row="5" x:Name="CreateQRButton" Content="Create QR" HorizontalAlignment="Stretch" Visibility="Collapsed" Margin="0,0,0,16" />

                    <Grid Grid.Row="7" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{StaticResource QuietButtonStyle}" ToolTipService.ToolTip="How to use QR code">
                            <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xE946;"/>
                            <Button.Flyout>
                                <Flyout>
                                    <TextBlock Style="{ThemeResource BodyTextBlockStyle}" Text="Use a camera or a special app to continue browsing on a new device." TextWrapping="Wrap" MaxWidth="200"/>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button Grid.Column="1" x:Name="GenerateQRCodeButton" Content="Generate" HorizontalAlignment="Center" />

                        <Button Grid.Column="2" x:Name="SaveQrImage" Style="{StaticResource QuietButtonStyle}" ToolTipService.ToolTip="Save QR Code">
                            <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xE78C;"/>
                        </Button>
                    </Grid>
                </Grid>
            </Flyout>
        </Grid.Resources>
            <graphite:GraphiteTabViewContainer 
            x:Name="Tabs"
            x:FieldModifier="public"
            Grid.Row="0"
            Margin="0,-20,0,0"
            VerticalAlignment="Stretch"
            HorizontalAlignment="Stretch"
            Mode="Modern"
            CanDragTabs="True"
            CanReorderTabs="True"
            Loaded="Tabs_Loaded"
            AddTabButtonClick="Tabs_AddTabButtonClick"
            TabCloseRequested="Tabs_TabCloseRequested">

            <graphite:GraphiteTabViewContainer.TabStripHeader>
                <PersonPicture
                    x:Name="Profile"
                    Width="32"
                    Height="32"
                    Margin="5,25,0,0"/>
            </graphite:GraphiteTabViewContainer.TabStripHeader>

            <graphite:GraphiteTabViewContainer.TabStripFooter>
                <Grid
                    x:Name="Apptitlebar"
                    MinWidth="175"
                    Margin="0,0,0,0"
                    IsHitTestVisible="False" />
            </graphite:GraphiteTabViewContainer.TabStripFooter>
        </graphite:GraphiteTabViewContainer>

        <Grid x:Name="ClassicToolbar" Height="37"
            Margin="0,44,0,0"
            VerticalAlignment="Top"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
			<Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button x:Name="BackBtn" Content="{graphitehelper:FluentIcon Glyph=&#xE72B;}" Tag="Back" Background="Transparent" BorderBrush="Transparent">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="B" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="ForwBtn" Content="{graphitehelper:FluentIcon Glyph=&#xE72A;}" Tag="Forward" Background="Transparent" BorderBrush="Transparent">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="F" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="ReloadBtn" Content="{graphitehelper:FluentIcon Glyph=&#xE72C;}" Tag="Refresh" Background="Transparent" BorderBrush="Transparent">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="R" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
                <Button x:Name="HomeBtn" Content="{graphitehelper:FluentIcon Glyph=&#xE80F;}" Tag="Home" Background="Transparent" BorderBrush="Transparent">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="H" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                </Button>
            </StackPanel>
            <Grid
                Grid.Column="1"
                Height="32"
                Margin="4,0,4,0"
                VerticalAlignment="Center">
                <AutoSuggestBox x:Name="SearchBox" x:Uid="SearchBar" x:FieldModifier="Public" BorderBrush="{ThemeResource ControlElevationBorderBrush}" CornerRadius="16" MaxSuggestionListHeight="500" Style="{ThemeResource PortalBarStyle}" TabIndex="1"/>
                <Button
                    x:Name="Secure"
                    Margin="2,0"
                    Padding="6"
                    x:FieldModifier="Public"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    CornerRadius="100"
                    IsDoubleTapEnabled="True">
                    <FontIcon FontFamily="{StaticResource FluentIcons}" />
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyout.MenuFlyoutPresenterStyle>
                                <Style TargetType="MenuFlyoutPresenter">
                                    <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                                    <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                                </Style>
                            </MenuFlyout.MenuFlyoutPresenterStyle>
                            <MenuFlyoutItem  Text="Open 2FA Tool">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xE192;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem  Text="Website Certificate">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xE72E;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="4">
                <Button
                    x:Name="ToolBoxMore"
                    Content="{graphitehelper:FluentIcon Glyph=&#xE70F;}"
                    Style="{StaticResource QuietButtonStyle}">
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                                    <Setter Property="Padding" Value="8" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button
                                    x:Name="ReadBtn"
                                    Padding="8"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Content="{graphitehelper:FluentIcon Glyph=&#xE736;}"
                                    Tag="ReadingMode"
                                    ToolTipService.ToolTip="Reading Mode" />
                                <Button
                                    x:Name="AdBlock"
                                    Padding="8"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Content="{graphitehelper:FluentIcon Glyph=&#xEA18;}"
                                    Tag="AdBlock"
                                    ToolTipService.ToolTip="Basic AdBlock" />
                                <Button
                                    x:Name="BtnTrans"
                                    Padding="8"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Content="{graphitehelper:FluentIcon Glyph=&#xE87E;}"
                                    Tag="Translate"
                                    ToolTipService.ToolTip="Translate" />
                                <Button
                                    x:Name="BtnDark"
                                    Padding="8"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    Content="{graphitehelper:FluentIcon Glyph=&#xE790;}"
                                    Tag="DarkMode"
                                    ToolTipService.ToolTip="DarkMode Website" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="AddFav"
                    Padding="8"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="{graphitehelper:FluentIcon Glyph=&#xE734;}"
                    Tag="AddFavoriteFlyout"
                    Visibility="Visible">
                    
                </Button>
                <TeachingTip
                    x:Name="AddFavTip"
                    Title="Adding Favorites"
                    IsLightDismissEnabled="True"
                    IsOpen="False"
                    PlacementMargin="10,10,0,0"
                    PreferredPlacement="BottomLeft"
                    Target="{Binding ElementName=AddFav}">
                    <TeachingTip.Content>
                        <StackPanel Padding="{ThemeResource TeachingTipContentMargin}" Spacing="16">
                            <TextBox x:Name="FavoriteTitle" PlaceholderText="Title Website" />
                            <TextBlock
                                x:Name="FavoriteUrl"
                                Foreground="{ThemeResource AccentAAFillColorSecondaryBrush}"
                                MaxLines="4"
                                TextWrapping="Wrap"
                                ToolTipService.ToolTip="{Binding Path=Text, RelativeSource={RelativeSource Mode=Self}}" />
                            <Button
                                x:Name="btnSaveFav"
                                HorizontalAlignment="Center"
                                
                                Content="Add Favorite"
                                Tag="AddFavorite">
                            </Button>
                        </StackPanel>
                    </TeachingTip.Content>
                </TeachingTip>
                <Button
                    x:Name="FavoritesButton"
                    Padding="8"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="{graphitehelper:FluentIcon Glyph=&#xE728;}"
                    Tag="Favorites" />
                <Button
                    x:Name="DownBtn"
                    Padding="8"
                    x:FieldModifier="Public"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="{graphitehelper:FluentIcon Glyph=&#xE896;}" />
                <Button
                    x:Name="History"
                    Padding="8"
                    x:FieldModifier="Public"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="{graphitehelper:FluentIcon Glyph=&#xE81C;}"
                    Tag="History" />
                <Button
                    x:Name="QrBtn"
                    Padding="8"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="{graphitehelper:FluentIcon Glyph=&#xED14;}"
                    Tag="QRCode"
                     Flyout="{StaticResource QRCodeFlyout}"/>
                <Button
                    x:Name="MoreTool"
                    x:Uid="ToolbarMoreButton"
                    Padding="8"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="{graphitehelper:FluentIcon Glyph=&#xE712;}"
                    Flyout="{StaticResource MoreFlyout}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>