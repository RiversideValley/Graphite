<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Graphite.Pages.SettingPages.AppearanceSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Graphite.Pages.SettingPages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:labs="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
   >

    <ScrollViewer>
        <StackPanel Margin="20,10,20,0">
            <TextBlock Text="Appearance Settings" 
                       Style="{ThemeResource TitleTextBlockStyle}" 
                       Margin="0,0,0,20"/>

            <labs:SettingsCard Description="Autofills the address bar from the Minibar" Header="Auto Fill TextBox">
                <labs:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEDA8;" />
                </labs:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="AutoTog"  />
            </labs:SettingsCard>

            <labs:SettingsCard Description="Change toolbar color" Header="Color Toolbar">
                <labs:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE790;" />
                </labs:SettingsCard.HeaderIcon>
                <Button>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xF354;" />
                    <Button.Flyout>
                        <Flyout>
                            <ColorPicker x:Name="ColorTBPicker" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </labs:SettingsCard>

            <labs:SettingsCard Description="Change TabView background color" Header="TabView background color">
                <labs:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE790;" />
                </labs:SettingsCard.HeaderIcon>
                <Button>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xF354;" />
                    <Button.Flyout>
                        <Flyout>
                            <ColorPicker x:Name="ColorTVPicker"  />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </labs:SettingsCard>

            <labs:SettingsCard Description="Change the NTP's (New Tab page's) text color" Header="NTP Text Color">
                <labs:SettingsCard.HeaderIcon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE790;" />
                </labs:SettingsCard.HeaderIcon>
                <Button>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xF354;" />
                    <Button.Flyout>
                        <Flyout>
                            <ColorPicker x:Name="ColorNtpPicker"  />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </labs:SettingsCard>

            <labs:SettingsExpander Description="Change the New Tab page's background image" Header="NTP background image">
                <labs:SettingsExpander.HeaderIcon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEC6C;" />
                </labs:SettingsExpander.HeaderIcon>
                <labs:SettingsExpander.Items>
                    <labs:SettingsCard Header="Change color">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE790;" />
                        </labs:SettingsCard.HeaderIcon>
                        <Button x:Name="Color">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xF354;" />
                            <Button.Flyout>
                                <Flyout>
                                    <ColorPicker x:Name="ColorBackGroundPicker"  />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </labs:SettingsCard>
                </labs:SettingsExpander.Items>
                <ComboBox x:Name="Type" >
                    <x:String>Default</x:String>
                    <x:String>Featured</x:String>
                    <x:String>Custom</x:String>
                </ComboBox>
            </labs:SettingsExpander>

            <labs:SettingsExpander Header="Navigation Icons">
                <labs:SettingsExpander.HeaderIcon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE759;" />
                </labs:SettingsExpander.HeaderIcon>
                <labs:SettingsExpander.Items>
                    <labs:SettingsCard Header="Back">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72B;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="BackSettings"
                    Tag="BackButton"
                    />
                    </labs:SettingsCard>
                    <labs:SettingsCard Header="Forward">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72A;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="ForwardSettings"
                    Tag="ForwardButton"
                    />
                    </labs:SettingsCard>
                    <labs:SettingsCard Header="Refresh">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE72C;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="ReloadSettings"
                    Tag="RefreshButton"
                    />
                    </labs:SettingsCard>
                    <labs:SettingsCard Header="Home">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE80F;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="HomeSettings"
                    Tag="HomeButton"
                     />
                    </labs:SettingsCard>
                </labs:SettingsExpander.Items>
            </labs:SettingsExpander>

            <labs:SettingsExpander Header="Toolbar icons">
                <labs:SettingsExpander.HeaderIcon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE737;" />
                </labs:SettingsExpander.HeaderIcon>
                <labs:SettingsExpander.Items>
                    <labs:SettingsCard Header="Downloads">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE896;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="Dwbl"
                    Tag="Downloads"
                    />
                    </labs:SettingsCard>
                    <labs:SettingsCard Header="Favorites List">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE728;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="Frbl"
                    Tag="FavoritesL"
                    />
                    </labs:SettingsCard>
                    <labs:SettingsCard Header="Favorites">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE734;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="FlAd"
                    Tag="Favorites"
                    />
                    </labs:SettingsCard>
                    <labs:SettingsCard Header="History">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE81C;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="Hsbl"
                    Tag="Historybtn"
                     />
                    </labs:SettingsCard>
                    <labs:SettingsCard Header="QR">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xED14;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="Qrbl"
                    Tag="QrCode"
                    />
                    </labs:SettingsCard>
                    <labs:SettingsCard Header="Web Tools">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE70F;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="Tlbl"
                    Tag="ToolIcon"
                     />
                    </labs:SettingsCard>
                </labs:SettingsExpander.Items>
            </labs:SettingsExpander>

            <labs:SettingsExpander Header="Tools Menu icons">
                <labs:SettingsExpander.HeaderIcon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE70F;" />
                </labs:SettingsExpander.HeaderIcon>
                <labs:SettingsExpander.Items>
                    <labs:SettingsCard Header="Force Dark Mode">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE790;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="Drbl"
                    Tag="DarkIcon"
                    />
                    </labs:SettingsCard>
                    <labs:SettingsCard Header="Translation">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE87E;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="Trbl"
                    Tag="Translate"
                    />
                    </labs:SettingsCard>
                    <labs:SettingsCard Header="Reading Mode">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE736;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="Read"
                    Tag="ReadButton"
                   />
                    </labs:SettingsCard>
                    <labs:SettingsCard Header="Basic AdBlock">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEA18;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="Adbl"
                    Tag="AdblockBtn"
                    />
                    </labs:SettingsCard>
                </labs:SettingsExpander.Items>
            </labs:SettingsExpander>

            <labs:SettingsExpander Header="UI Settings">
                <labs:SettingsExpander.HeaderIcon>
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEB3C;" />
                </labs:SettingsExpander.HeaderIcon>
                <labs:SettingsExpander.Items>
                    <labs:SettingsCard Description="Show Search On Home Page" Header="Search Visible">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xF78B;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="SearchHome"
                    Tag="IsSearchVisible"
                     />
                    </labs:SettingsCard>
                    <labs:SettingsCard Description="Show History On Home Page" Header="History Visible">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE81C;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="HistoryHome"
                    Tag="IsHistoryVisible"
                    />
                    </labs:SettingsCard>
                    <labs:SettingsCard Description="Show Favorites On Home Page" Header="Favorites Visible">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE734;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="FavoritesHome"
                    Tag="IsFavoritesVisible"
                     />
                    </labs:SettingsCard>
                    <labs:SettingsCard Description="Show Trending On Home Page" Header="Trending Visible">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7B5;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="TrendingHome"
                    Tag="IsTrendingVisible"
                     />
                    </labs:SettingsCard>
                    <labs:SettingsCard Description="Show Logo On Home Page" Header="Logo Visible">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEDE5;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="LogoHome"
                    Tag="IsLogoVisible"
                     />
                    </labs:SettingsCard>
                    <labs:SettingsCard Description="Show Select Bar On Home Page" Header="Select Bar Visible">
                        <labs:SettingsCard.HeaderIcon>
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xEE64;" />
                        </labs:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                    x:Name="SelectbarHome"
                    Tag="NewTabSelectorBarVisible"
                     />
                    </labs:SettingsCard>
                </labs:SettingsExpander.Items>
            </labs:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>