<Window
    x:Class="Graphite.Migration.ReceiverWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Graphite Data Receiver">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Height="32" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="/Assets/AppLogo.png" Width="24" Height="24" Margin="8,0,0,0"/>
            <TextBlock x:Name="AppTitleTextBlock" Text="Graphite Data Receiver" 
                       Style="{StaticResource CaptionTextBlockStyle}" 
                       VerticalAlignment="Center" 
                       Grid.Column="1" Margin="8,0,0,0"/>
        </Grid>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1" Padding="24">
            <StackPanel MaxWidth="600" Margin="0,20" HorizontalAlignment="Center">
                <!-- Header -->
                <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,32">
                    <Image Source="/Assets/AppLogo.png" Width="64" Height="64"/>
                    <TextBlock Text="Secure Data Receiver" 
                               Style="{StaticResource TitleTextBlockStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Receive data securely from another Graphite device" 
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextAlignment="Center"/>
                </StackPanel>

                <!-- Main Card -->
                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Step 1: Waiting for Connection -->
                    <StackPanel Grid.Row="0" Spacing="8">
                        <TextBlock Text="Step 1: Wait for Sender Connection" 
                                   Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="The receiver is listening for incoming connections"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ProgressRing x:Name="LoadingProgressRing" 
                                      IsActive="True" 
                                      Width="32" 
                                      Height="32"
                                      Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Step 2: Enter Verification Code -->
                    <StackPanel Grid.Row="1" Margin="0,24,0,0" Spacing="8">
                        <TextBlock Text="Step 2: Enter Verification Code" 
                                   Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="Enter the 8-digit code provided by the sender"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBox x:Name="VerificationCodeTextBox"
                                 PlaceholderText="Enter 8-digit code"
                                 Width="200"
                                 HorizontalAlignment="Left"
                                 Margin="0,8,0,0"
                                 IsEnabled="False"/>
                    </StackPanel>

                    <!-- Step 3: Verify and Receive -->
                    <StackPanel Grid.Row="2" Margin="0,24,0,0" Spacing="8">
                        <TextBlock Text="Step 3: Verify and Receive Data" 
                                   Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="Click the button to verify the code and start receiving data"
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button x:Name="VerifyButton"
                                Content="Verify &amp; Receive Data"
                                Click="VerifyButton_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Margin="0,8,0,0"
                                IsEnabled="False"/>
                    </StackPanel>
                </Grid>

                <!-- Status Card -->
                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="24"
                      Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon x:Name="StatusIcon" 
                              Glyph="&#xE946;"
                              FontFamily="Segoe Fluent Icons"
                              Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="Status" 
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock x:Name="StatusTextBlock" 
                                   Text="Waiting for sender connection..." 
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="24"
                      Margin="0,16,0,0">
                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <ProgressBar x:Name="ProgressBar" 
       Visibility="Collapsed"
       Minimum="0" 
       Maximum="100" 
       Height="20"/>
                        <TextBlock x:Name="ProgressTextBlock" 
     Visibility="Collapsed"
     Text="0%" 
     HorizontalAlignment="Center" 
     Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Security Notice -->
                <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="16"
                      Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE72E;"
                              FontFamily="Segoe Fluent Icons"
                              Margin="0,0,12,0"/>

                    <TextBlock Grid.Column="1"
                               Text="All data is encrypted during transfer. Only enter verification codes from trusted sources."
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

