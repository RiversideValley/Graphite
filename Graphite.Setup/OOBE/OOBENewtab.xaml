<Page
    x:Class="Graphite.Setup.OOBE.OOBENewtab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Graphite.Setup.OOBE"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5,5,5,0">
            <Button x:Name="HelpButton"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Margin="0,0,0,0"
                    Click="HelpButton_Click">
                <SymbolIcon Symbol="Help" Foreground="White"/>
            </Button>
            <TextBlock Text="Graphite - New Tab Settings" Foreground="White" VerticalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20" Spacing="20" HorizontalAlignment="Center" MaxWidth="600">
                <controls:SettingsExpander Header="New Tab Content"
                                           Description="Configure what appears on new tabs"
                                           IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xE8A5;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                New Tab Page Type
                            </controls:SettingsCard.Header>
                            <ComboBox x:Name="NewTabPageTypeComboBox" Width="200">
                                <ComboBoxItem Content="Blank Page"/>
                                <ComboBoxItem Content="Quick Links"/>
                                <ComboBoxItem Content="Custom URL"/>
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                Custom URL
                            </controls:SettingsCard.Header>
                            <TextBox x:Name="CustomUrlTextBox" PlaceholderText="https://example.com" Width="300"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                Show Search Bar
                            </controls:SettingsCard.Header>
                            <ToggleSwitch x:Name="ShowSearchBarToggle"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="Quick Links"
                                           Description="Configure quick links on new tab page"
                                           IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xE71B;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                Show Quick Links
                            </controls:SettingsCard.Header>
                            <ToggleSwitch x:Name="ShowQuickLinksToggle"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                Number of Quick Links
                            </controls:SettingsCard.Header>
                            <NumberBox x:Name="QuickLinksCountBox" Minimum="1" Maximum="12" Value="8"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                Use Most Visited Sites
                            </controls:SettingsCard.Header>
                            <ToggleSwitch x:Name="UseMostVisitedSitesToggle"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="Background"
                                           Description="Configure new tab background"
                                           IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xE7F4;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                Background Type
                            </controls:SettingsCard.Header>
                            <ComboBox x:Name="BackgroundTypeComboBox" Width="200">
                                <ComboBoxItem Content="Solid Color"/>
                                <ComboBoxItem Content="Custom Image"/>
                                <ComboBoxItem Content="Daily Image"/>
                            </ComboBox>
                        </controls:SettingsCard>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                Background Color
                            </controls:SettingsCard.Header>
                            <TextBox x:Name="BackgroundColorTextBox" PlaceholderText="#RRGGBB" Width="120"/>
                        </controls:SettingsCard>
                        <controls:SettingsCard>
                            <controls:SettingsCard.Header>
                                Custom Image URL
                            </controls:SettingsCard.Header>
                            <TextBox x:Name="CustomImageUrlTextBox" PlaceholderText="https://example.com/image.jpg" Width="300"/>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <Button x:Name="NextStep" 
                        HorizontalAlignment="Center" 
                        Click="NextStep_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        CornerRadius="20"
                        Padding="24,12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Next Step" VerticalAlignment="Center"/>
                        <FontIcon Glyph="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>