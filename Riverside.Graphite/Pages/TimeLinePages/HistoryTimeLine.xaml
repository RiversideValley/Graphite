<Page
    x:Class="Riverside.Graphite.Pages.TimeLinePages.HistoryTimeLine"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:Riverside.Graphite.Data.Core.Models"
    xmlns:firebrowser="using:Riverside.Graphite.Controls"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <CommandBarFlyout x:Name="FlyDeleteItem" x:FieldModifier="Public">
            <AppBarButton
                Margin="{ThemeResource XXSmallLeftTopRightBottomMargin}"
                Command="{x:Bind ViewModel.DeleteItemCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}}"
                Icon="{firebrowser:FluentIcon Glyph=&#xE74D;}"
                Label="Delete This Record" />
            <AppBarButton
                Margin="{ThemeResource XXSmallLeftTopRightBottomMargin}"
                Command="{x:Bind ViewModel.CollectionShowCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource Mode=Self}}"
                Icon="TwoPage"
                Label="Collections" />
        </CommandBarFlyout>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            Margin="{ThemeResource MediumTopBottomMargin}"
            HorizontalAlignment="Center"
            Orientation="Horizontal">
            <TextBox
                x:Name="Ts"
                Width="300"
                HorizontalAlignment="Left"
                PlaceholderText="Search History Here"
                Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                x:Name="Delete"
                Margin="{ThemeResource XXSmallLeftTopRightBottomMargin}"
                HorizontalAlignment="Right"
                Command="{x:Bind ViewModel.RemoveAllHistoryCommand}"
                Style="{StaticResource TextBlockButtonStyle}"
                ToolTipService.ToolTip="Delete All History">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontFamily="{StaticResource FluentIcons}" Glyph="&#xE107;" />
                    <TextBlock>Delete all history</TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>

        <ListView
            x:Name="BigTemp"
            Grid.Row="1"
            Margin="{ThemeResource XXSmallLeftTopRightBottomMargin}"
            ItemsSource="{x:Bind ViewModel.BrowserHistory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            RightTapped="{x:Bind ViewModel.ShowContextMenu}"
            SelectedItem="{x:Bind ViewModel.SelectedHistoryItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <ListView.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromHorizontalOffset="100" FromVerticalOffset="100" />
                </TransitionCollection>
            </ListView.Transitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="data:HistoryItem">
                    <Grid Margin="5" Background="{ThemeResource LayerOnMicaBaseAltFillColorTransparentBrush}">
                        <Image
                            Width="32"
                            Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Source="{Binding ImageSource}" />
                        <StackPanel Grid.Column="1" Margin="36,0,0,0">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{Binding Title}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                FontWeight="ExtraBold"
                                Foreground="{ThemeResource SystemAccentColor}"
                                MaxLines="2"
                                Text="{Binding Url}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Text="{Binding LastVisitTime}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>