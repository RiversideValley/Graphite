<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Graphite.Setup.OOBE.OOBEUser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Graphite.Setup.OOBE"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.0" Color="#7B3AED" />
                <GradientStop Offset="0.33" Color="#FF6B00" />
                <GradientStop Offset="0.66" Color="#FF3D00" />
                <GradientStop Offset="1.0" Color="#4F46E5" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Back Button, Help Icon, Image Icon, and Text  -->
        <StackPanel
            Grid.Row="0"
            Margin="{ThemeResource XXSmallLeftTopRightBottomMargin}"
            Orientation="Horizontal">
            <Button
                x:Name="HelpButton"
                Margin="0,0,0,0"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="HelpButton_Click">
                <SymbolIcon Foreground="White" Symbol="Help" />
                <ToolTipService.ToolTip>
                    <ToolTip Content="Get help with account creation" />
                </ToolTipService.ToolTip>
            </Button>
            <TextBlock
                VerticalAlignment="Center"
                Foreground="White"
                Text="Graphite - User Setup" />
        </StackPanel>


        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="15">
            <!--  User Creation Card  -->
            <Border
                Width="400"
                Padding="20"
                Background="#80000000"
                CornerRadius="8">
                <StackPanel Spacing="16">
                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="24"
                        Foreground="White"
                        Style="{ThemeResource TitleLargeTextBlockStyle}"
                        Text="Create Account" />

                    <!--  Image Preview  -->
                    <PersonPicture
                        x:Name="UserImagePreview"
                        Width="75"
                        Height="75"
                        HorizontalAlignment="Center" />

                    <!--  Live Username Update  -->
                    <TextBlock
                        x:Name="LiveUsernameUpdate"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontStyle="Oblique"
                        Foreground="White"
                        Style="{ThemeResource BodyTextBlockStyle}" />
                    <TextBlock
                        x:Name="LiveEmailUpdate"
                        Margin="0,-15,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        FontStyle="Oblique"
                        Foreground="White"
                        Style="{ThemeResource BodyTextBlockStyle}" />

                    <ComboBox
                        x:Name="UserImageComboBox"
                        HorizontalAlignment="Stretch"
                        Header="Select User Image"
                        SelectionChanged="UserImageComboBox_SelectionChanged">
                        <ComboBox.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="White" Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.HeaderTemplate>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Image
                                        Width="32"
                                        Height="32"
                                        Margin="0,0,8,0"
                                        Source="{Binding ImagePath}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox
                        x:Name="UsernameTextBox"
                        Header="Username"
                        MaxLength="30"
                        PlaceholderText="Enter username"
                        TextChanged="UsernameTextBox_TextChanged">
                        <TextBox.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="White" Text="{Binding}" />
                            </DataTemplate>
                        </TextBox.HeaderTemplate>
                    </TextBox>

                    <TextBox
                        x:Name="EmailTextBox"
                        Header="Email"
                        MaxLength="40"
                        PlaceholderText="Enter Email (Optional)"
                        TextChanged="EmailTextBox_TextChanged">
                        <TextBox.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="White" Text="{Binding}" />
                            </DataTemplate>
                        </TextBox.HeaderTemplate>
                    </TextBox>

                    <Grid>
                        <PasswordBox
                            x:Name="PasswordBox"
                            Header="Password"
                            MaxLength="25"
                            PlaceholderText="Enter password (Optional)">
                            <PasswordBox.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Foreground="White" Text="{Binding}" />
                                </DataTemplate>
                            </PasswordBox.HeaderTemplate>
                        </PasswordBox>
                        <Button
                            x:Name="TogglePasswordVisibilityButton"
                            Padding="8,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            Click="TogglePasswordVisibilityButton_Click">
                            <FontIcon
                                x:Name="PasswordVisibilityIcon"
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="White"
                                Glyph="&#xE7B3;" />
                        </Button>
                    </Grid>

                    <Button
                        x:Name="CreateUserButton"
                        HorizontalAlignment="Stretch"
                        Click="CreateUserButton_Click"
                        Content="Create Account">
                        <Button.Resources>
                            <ResourceDictionary>
                                <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                                    <Setter Property="CornerRadius" Value="20" />
                                    <Setter Property="Padding" Value="24,12" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </ResourceDictionary>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>

            <!--  Next Step Button (Initially Hidden)  -->
            <Button
                x:Name="NextStepButton"
                HorizontalAlignment="Center"
                Click="NextStepButton_Click"
                Visibility="Collapsed">
                <Button.Resources>
                    <ResourceDictionary>
                        <Style BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
                            <Setter Property="CornerRadius" Value="20" />
                            <Setter Property="Padding" Value="24,12" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </ResourceDictionary>
                </Button.Resources>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock VerticalAlignment="Center" Text="Next Step" />
                    <FontIcon
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="16"
                        Glyph="&#xE72A;" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Page>