<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Riverside.Graphite.Controls.FileDialogs.LocationSelectionDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Riverside.Graphite.Controls.FileDialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Select Save Location">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="AppTitleBar" Height="32" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="applogo.png" Width="24" Height="24" Margin="8,0,0,0"/>
            <TextBlock x:Name="AppTitleTextBlock" Text="Select Save Location" 
                       Style="{StaticResource CaptionTextBlockStyle}" 
                       VerticalAlignment="Center" 
                       Grid.Column="1" Margin="8,0,0,0"/>
        </Grid>

        <!-- Main content -->
        <Grid Grid.Row="1" Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Text="Select a folder to save your file" 
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Margin="0,0,0,16"/>

            <!-- Known Folders ListView -->
            <ListView x:Name="KnownFoldersListView"
                      Grid.Row="1"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="KnownFoldersListView_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Bottom bar with Browse button and current folder display -->
        <Grid Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BrowseButton" Click="BrowseButton_Click">
                <FontIcon Glyph="&#xE8DA;" FontFamily="Segoe Fluent Icons"/>
                <Button.Flyout>
                    <Flyout>
                        <Grid Width="300" Height="400">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Button x:Name="ParentFolderButton" Content="Parent Folder" Click="ParentFolderButton_Click" Margin="0,0,0,8"/>
                            <ListView x:Name="FlyoutFolderListView"
                                          Grid.Row="1"
                                          SelectionMode="Single"
                                          IsItemClickEnabled="True"
                                          ItemClick="FlyoutFolderListView_ItemClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <FontIcon Glyph="&#xE8B7;" FontFamily="Segoe Fluent Icons"/>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button x:Name="CancelFlyoutButton" Content="Cancel" Margin="0,0,8,0" Click="CancelFlyoutButton_Click"/>
                                <Button x:Name="SaveFlyoutButton" Content="Save" Click="SaveFlyoutButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <TextBlock x:Name="CurrentFolderTextBlock" Grid.Column="1" VerticalAlignment="Center" Margin="16,0"/>
            <Button x:Name="CancelButton" Content="Cancel" Click="CancelButton_Click" Grid.Column="2" Margin="0,0,8,0"/>
            <Button x:Name="SelectButton" Content="Select" Click="SelectButton_Click" Style="{StaticResource AccentButtonStyle}" Grid.Column="3"/>
        </Grid>
    </Grid>
</Window>